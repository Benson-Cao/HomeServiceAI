{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-harness.local/schemas/evidence.schema.json",
  "title": "Evidence",
  "contract_version": "1.2.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "quotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_count": {
      "type": "integer",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "freshness": {
      "type": "string",
      "enum": [
        "new",
        "strengthening",
        "stable",
        "weakening",
        "stale"
      ]
    },
    "valid_time": {
      "$ref": "time-model.schema.json#/properties/valid_from"
    }
  },
  "required": [
    "quotes",
    "proof_count",
    "confidence",
    "freshness"
  ]
}
