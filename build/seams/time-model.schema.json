{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-harness.local/schemas/time-model.schema.json",
  "title": "TimeModel（bi-temporal）",
  "contract_version": "1.2.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "valid_to": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    }
  },
  "required": [
    "occurred_at",
    "recorded_at"
  ],
  "x-note": "valid time ≠ 记录时间；更正事实须保留旧证据链，禁止单时间戳覆盖式更新"
}
