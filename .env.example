# 复制为 .env 后按需修改；.env 已被 .gitignore / .dockerignore / npm pack 排除。
# L0（PG）与 ②（真模型）都是可选能力：不填这些也能跑 npm run verify。

POSTGRES_USER=mh
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=memory_harness
POSTGRES_PORT=5432

# app 容器内走服务名 db；宿主机脚本会自动把 @db: 换成 @localhost:POSTGRES_PORT
MH_PG_DSN=postgres://mh:change-me-in-production@db:5432/memory_harness

# CLI 默认值（可选），也可用 -e 覆盖
MH_PRINCIPAL=parent
MH_BANK=home

# ── ③ 常驻 REST 服务 ───────────────────────────────────────
# 宿主机映射端口；容器内固定 8080（MH_HTTP_PORT），两者分开避免不一致
MH_HTTP_HOST_PORT=8080
MH_HTTP_HOST=0.0.0.0
MH_HTTP_PORT=8080
# 留空 = 不鉴权；填了则除 /health 外所有端点要求 Authorization: Bearer <token>
MH_HTTP_TOKEN=
MH_WORKER_INTERVAL_MS=1000
# 探测已运行服务的地址（smoke:daemon 用）
MH_HTTP_URL=http://127.0.0.1:8080

# ── ② 真模型（只有显式跑 smoke:llm 才需要）────────────────────
# 云 API 密钥：留空时 smoke:llm 会 SKIP，不会失败、不会发网络
DEEPSEEK_API_KEY=
# 模型名以 smoke 打印的 /models 当期返回为准，不要依赖文档快照
# 留空则用代码默认值 deepseek-flash
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=20000

# 本地 OpenAI 兼容网关（--local 模式，无需云密钥）
LLM_LOCAL_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
LLM_LOCAL_MODEL=

# ── ④ 身份与审计（推荐开启）──────────────────────────────────
# 生成：openssl rand -hex 32
# 填了 MH_IDENTITY_SECRET 且存在成员目录时，principal 由签名 token 派生；
# 此时忽略 MH_HTTP_TOKEN（两者互斥）。留空则回退 ③ 的共享 Bearer / 无鉴权。
MH_IDENTITY_SECRET=
# 容器内目录路径；先 cp config/members.example.json config/members.json
MH_MEMBERS_FILE=/app/config/members.json
# 也可直接用内联 JSON 覆盖文件（优先级更高）
MH_MEMBERS=
# 成员 token 默认有效期（秒），签发脚本用
MH_TOKEN_TTL_SECONDS=2592000

