{
  "name": "@memory-harness/contracts",
  "version": "1.2.0",
  "description": "Frozen vocabulary and seam contracts for Memory Harness (no kernel implementation)",
  "type": "module",
  "license": "MIT",
  "private": false,
  "files": [
    "seams/",
    "src/",
    "build/",
    "ci/",
    "docs/",
    "tests/",
    "examples/",
    "scripts/",
    "config/",
    "docker/",
    ".github/",
    "Dockerfile",
    "docker-compose.yml",
    ".dockerignore",
    ".env.example",
    "CONTRACTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md"
  ],
  "scripts": {
    "pretest": "npm run build",
    "preacceptance": "npm run build",
    "pregovernance": "npm run build",
    "prestack": "npm run build",
    "predump:tree": "npm run build",
    "prepack": "npm run build",
    "build": "node ci/build.mjs",
    "check:schemas": "node ci/check-schemas.mjs",
    "check:kernel": "node ci/kernel-purity.mjs --dir src/kernel",
    "test": "node --test",
    "verify": "npm run check:schemas && npm run check:kernel && npm test",
    "acceptance": "node --test tests/acceptance.test.mjs",
    "governance": "node --test tests/governance.test.mjs",
    "stack": "node --test tests/v07-full-stack.test.mjs",
    "dump:tree": "node build/src/kernel/cli.js --dump-tree",
    "smoke:stack": "node scripts/smoke-stack.mjs",
    "smoke:llm": "node scripts/smoke-llm.mjs",
    "smoke:daemon": "node scripts/smoke-daemon.mjs",
    "token:issue": "node scripts/issue-token.mjs",
    "audit:recent": "node scripts/audit-query.mjs",
    "push:deferred": "node scripts/deferred-push.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "compose:config": "docker compose config -q"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.6.3"
  },
  "optionalDependencies": {
    "pg": "^8.13.1"
  }
}
